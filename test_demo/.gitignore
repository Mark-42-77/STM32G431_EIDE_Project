# ========================
# Keil MDK-ARM Build Output
# ========================

# 编译产物目录
MDK-ARM/test_demo/

# 或者更精确地忽略特定扩展名
*.o
*.d
*.crf
*.axf
*.lst
*.dep
*.build_log.htm
*.htm
*.lnp
*.map
*.sct

# ========================
# 用户特定配置文件
# ========================

# Keil 窗口布局 (每个用户不同)
*.uvguix.*

# Keil 调试选项 (包含断点等调试信息)
# 如果团队需要共享调试配置，可以注释掉这行
*.uvoptx

# 调试器配置目录
MDK-ARM/DebugConfig/

# RTE 运行时环境组件 (可由Keil自动生成)
MDK-ARM/RTE/

# ========================
# 可选保留的文件
# ========================

# 如果希望保留 HEX 烧录文件，注释掉下面这行
# *.hex

# ========================
# 操作系统临时文件
# ========================

# Windows
Thumbs.db
Desktop.ini
*.tmp

# macOS
.DS_Store
._*

# ========================
# 编辑器/IDE 临时文件
# ========================

# VSCode
.vscode/

# JetBrains
.idea/

# Backup files
*~
*.bak
*.swp